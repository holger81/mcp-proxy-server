+  /**
+   * Map user-facing mailbox names to the exact path returned by LIST.
+   * Exchange/Outlook often stall on UID COPY when the destination string does not match the
+   * server's canonical folder path (e.g. ``INBOX`` vs ``Inbox``).
+   */
+  private static resolveMailboxPath(
+    list: Awaited<ReturnType<ImapFlow['list']>>,
+    requested: string,
+  ): string {
+    const r = requested.trim();
+    if (!r) return r;
+
+    const normSu = (su?: string): string =>
+      (su || '')
+        .replace(/^\\/u, '')
+        .toLowerCase();
+
+    const exact = list.find((m) => m.path === r);
+    if (exact) return exact.path;
+
+    const rl = r.toLowerCase();
+    const ci = list.find((m) => m.path.toLowerCase() === rl);
+    if (ci) return ci.path;
+
+    if (rl === 'inbox') {
+      const inbox = list.find((m) => normSu(m.specialUse) === 'inbox');
+      if (inbox) return inbox.path;
+    }
+
+    if (rl.includes('junk') || rl === 'spam') {
+      const junk = list.find((m) => normSu(m.specialUse).includes('junk'));
+      if (junk) return junk.path;
+    }
+
+    return r;
+  }
+
